# Copie este arquivo para ".env" se quiser ajustar os padroes.

# Modelo local do Ollama. Instale/baixe com:
# ollama pull llama3.1:8b
PROSPECTADOR_MODELO=llama3.1:8b

# URL local do Ollama. Nao e API externa; roda na sua maquina.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Tempo maximo de resposta do modelo local, em segundos.
PROSPECTADOR_OLLAMA_TIMEOUT=120

# Quantos sites o enriquecimento visita em paralelo.
PROSPECTADOR_CONCORRENCIA=8

# Porta da interface visual (iniciar.bat). Definida aqui, e' usada como esta e
# falha se estiver ocupada. Comentada, o programa procura uma livre a partir da
# 8765.
PROSPECTADOR_PORTA=8765

# Onde fica o historico de leads ja prospectados.
PROSPECTADOR_HISTORICO=historico.json
